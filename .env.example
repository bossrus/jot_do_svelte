DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/quick_todo

SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JotDo <no-reply@jotdo.site>

APP_URL=http://localhost:5173

BETTER_AUTH_SECRET=

# Enables direct test purchases through /api/billing/payment-success.
ENABLE_FAKE_PAYMENTS=false

R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MAX_IMAGE_SIZE_BYTES=10485760

# Paddle Billing. Use sandbox IDs locally and live IDs in production.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_SANDBOX_API_KEY=
PADDLE_WEBHOOK_SECRET=
PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_CLOUD_MONTH=
PADDLE_PRICE_CLOUD_YEAR=
PADDLE_PRICE_CLOUD_FIVE_YEARS=
PADDLE_PRICE_JOIN_MONTH=
PADDLE_PRICE_JOIN_YEAR=
PADDLE_PRICE_JOIN_FIVE_YEARS=
PADDLE_PRICE_SHARE_MONTH=
PADDLE_PRICE_SHARE_YEAR=
PADDLE_PRICE_SHARE_FIVE_YEARS=
PADDLE_PRICE_GROUP_MONTH=
PADDLE_PRICE_GROUP_YEAR=
PADDLE_PRICE_GROUP_FIVE_YEARS=

RECURRING_SCHEDULER_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com
